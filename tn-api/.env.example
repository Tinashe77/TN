PORT=8080
NODE_ENV=development
# Development MongoDB. Production: use an Atlas mongodb+srv:// connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tn_investments

# Staff portal: /admin/ on the API host. Password must be at least 20 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_URL=

# Optional notifications; saved enquiries remain available if these are unset.
SMTP_USER=
SMTP_PASS=
INVESTMENT_ENQUIRY_TO=
