PORT=8080
NODE_ENV=development
# Use a local PostgreSQL database for development; never use production data in tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tn_investments
DATABASE_SSL=false
# Production: Render internal database URL and DATABASE_SSL=true.

# Staff portal: /admin/ on the API host. Password must be at least 20 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_URL=

# Optional notifications; saved enquiries remain available if these are unset.
SMTP_USER=
SMTP_PASS=
INVESTMENT_ENQUIRY_TO=
